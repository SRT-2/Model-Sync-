{
  "evaluation_version": "2.0",
  "provider": {
    "name": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "allow_fallbacks": false,
    "request_timeout_seconds": 120,
    "generation_reconcile_attempts": 3,
    "generation_reconcile_delay_seconds": 0.5
  },
  "dataset": {
    "path": "benchmarks/dataset_v2_80.json",
    "expected_total": 80,
    "expected_categories": {
      "CODING": 27,
      "UNIT_TESTING": 27,
      "REASONING": 26
    },
    "expected_unique_ids": true,
    "expected_unique_prompts": true
  },
  "models": {
    "classifier": "z-ai/glm-5.3-flash",
    "coding": "z-ai/glm-5.3-flash",
    "unit_testing": "deepseek/deepseek-v4-flash-0731",
    "reasoning": "openai/gpt-5.6-luna",
    "baseline": "anthropic/claude-sonnet-5"
  },
  "generation": {
    "temperature": 0,
    "max_output_tokens": 500,
    "classifier_temperature": 0,
    "classifier_max_output_tokens": 20,
    "include_usage": true
  },
  "execution": {
    "default_max_cost_usd": 1,
    "delay_between_prompts_seconds": 0.5,
    "streaming_for_cost_comparison": false,
    "response_quality_scoring": false
  },
  "accounting": {
    "reconcile_each_generation": true,
    "save_raw_generation_records": true,
    "actual_cost_source_priority": [
      "generation_record.total_cost",
      "generation_record.cost",
      "completion_response.usage.cost"
    ],
    "catalog_estimates_are_separate_from_actual_billing": true
  },
  "secrets": {
    "api_key_env": "OPENROUTER_API_KEY",
    "baseline_api_key_env": "OPENROUTER_BASELINE_API_KEY",
    "router_api_key_env": "OPENROUTER_ROUTER_API_KEY"
  },
  "selected_model_reference": {
    "source": "User-provided OpenRouter model-page screenshots",
    "observed_at_utc": "2026-11-12T14:48:16Z",
    "currency": "USD",
    "reference_prices_per_million_tokens": {
      "z-ai/glm-5.3-flash": {
        "input": 0.0399,
        "output": 0.0784
      },
      "deepseek/deepseek-v4-flash-0731": {
        "input": 0.0434,
        "output": 0.3
      },
      "openai/gpt-5.6-luna": {
        "input": 0.2,
        "output": 1.2
      },
      "anthropic/claude-sonnet-5": {
        "input": 2,
        "output": 10
      }
    },
    "note": "Reference prices transcribed from screenshots; execution-time catalogue snapshot and generation-level actual cost are the accounting sources for the run."
  }
}