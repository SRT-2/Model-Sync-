# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Required: Provider API Key -----------------------------------------
# OpenRouter (default): Get one at https://openrouter.ai
OPENROUTER_API_KEY=
# Or Together AI:
# TOGETHER_API_KEY=

# --- Optional: Server Configuration ------------------------------------
ROUTER_PORT=8000
ROUTER_HOST=0.0.0.0
# Set to require `Authorization: Bearer <value>` on incoming requests:
ROUTER_API_KEY=

# --- Optional: Upstream Connection Settings -----------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
UPSTREAM_TIMEOUT_SECONDS=120
UPSTREAM_MAX_RETRIES=2

# --- Optional: Downstream Specialized Models ---------------------------
# OpenRouter Examples:
CODING_MODEL=google/gemma-4-31b-it:free
TESTING_MODEL=google/gemma-4-26b-a4b-it:free
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CLASSIFIER_MODEL=poolside/laguna-s-2.1:free

# Together AI Examples:
# CODING_MODEL=zai-org/GLM-5.1
# TESTING_MODEL=moonshotai/Kimi-K2.6
# REASONING_MODEL=Qwen/Qwen3.7-Max
# CLASSIFIER_MODEL=Qwen/Qwen3.7-Max

# --- Evaluation V2: optional separate keys for auditable cost comparison --
# Recommended: create separate OpenRouter keys so Activity can separate the
# baseline experiment from ModelSync. If omitted, OPENROUTER_API_KEY is used.
OPENROUTER_BASELINE_API_KEY=
OPENROUTER_ROUTER_API_KEY=

# Evaluation V2 model IDs. Fill these only after verifying exact IDs and
# current prices in https://openrouter.ai/models and saving a catalogue snapshot.
OPENROUTER_BASELINE_MODEL=anthropic/claude-sonnet-5
OPENROUTER_CLASSIFIER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_CODING_MODEL=z-ai/glm-5.3-flash
OPENROUTER_UNIT_TESTING_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_REASONING_MODEL=openai/gpt-5.6-luna
